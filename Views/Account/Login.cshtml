@model TuProyecto.Models.Usuario

@{
    ViewBag.Title = "Login";
    Layout = null; // 👈 para que no use el layout general
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Login</title>

    <style>
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: linear-gradient(135deg, #4e73df, #1cc88a);
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .login-container {
            background: #fff;
            padding: 40px;
            width: 320px;
            border-radius: 10px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.2);
            text-align: center;
        }

            .login-container h2 {
                margin-bottom: 20px;
                color: #333;
            }

        .input-group {
            margin-bottom: 15px;
            text-align: left;
        }

            .input-group label {
                font-size: 14px;
                color: #555;
            }

            .input-group input {
                width: 100%;
                padding: 10px;
                border-radius: 5px;
                border: 1px solid #ccc;
                margin-top: 5px;
            }

        .btn-login {
            width: 100%;
            padding: 10px;
            background: #4e73df;
            border: none;
            color: white;
            border-radius: 5px;
            font-size: 16px;
            cursor: pointer;
        }

            .btn-login:hover {
                background: #2e59d9;
            }

        .error {
            color: red;
            margin-top: 10px;
        }

        .logo {
            font-size: 22px;
            font-weight: bold;
            margin-bottom: 15px;
            color: #4e73df;
        }
    </style>
</head>
<body>

    <div class="login-container">
        <div class="logo">Mi Sistema</div>
        <h2>Iniciar Sesión</h2>

        @using (Html.BeginForm("Login", "Account", FormMethod.Post))
        {
            <div class="input-group">
                <label>Usuario</label>
                @Html.TextBoxFor(m => m.Username, new { @placeholder = "Ingrese usuario" })
            </div>

            <div class="input-group">
                <label>Contraseña</label>
                @Html.PasswordFor(m => m.Password, new { @placeholder = "Ingrese contraseña" })
            </div>

            <button type="submit" class="btn-login">Ingresar</button>
        }

        @if (ViewBag.Error != null)
        {
            <div class="error">@ViewBag.Error</div>
        }
    </div>

</body>
</html>